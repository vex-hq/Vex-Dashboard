# Copy this file to .env.development and fill in real values.
# NEVER commit .env.development — it is gitignored.

# SUPABASE (local dev instance)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=<your-local-supabase-anon-key>
SUPABASE_SECRET_KEY=<your-local-supabase-secret-key>
SUPABASE_DB_WEBHOOK_SECRET=WEBHOOKSECRET

# EMAILS
EMAIL_SENDER="Vex <noreply@tryvex.dev>"
EMAIL_PORT=54325
EMAIL_HOST=localhost
EMAIL_TLS=false
EMAIL_USER=user
EMAIL_PASSWORD=password

# CONTACT FORM
CONTACT_EMAIL=hello@tryvex.dev

# STRIPE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# MAILER
MAILER_PROVIDER=nodemailer

# AGENTGUARD
NEXT_PUBLIC_AGENTGUARD_WS_URL=wss://ws.tryvex.dev/ws
AGENTGUARD_DATABASE_URL=<your-neon-db-connection-string>
AGENTGUARD_S3_ENDPOINT=<your-r2-endpoint>
AGENTGUARD_S3_REGION=auto
AGENTGUARD_S3_BUCKET=agentguard-traces
AGENTGUARD_S3_ACCESS_KEY_ID=<your-r2-access-key>
AGENTGUARD_S3_SECRET_ACCESS_KEY=<your-r2-secret-key>

# REQUIRED for the realtime feed. Shared HMAC secret with dashboard-api, which
# holds the same value as DASHBOARD_WS_TOKEN_SECRET — the two MUST match or
# every WebSocket connection is refused and the live charts stop updating.
#
# This app signs a short-lived org-scoped token with it, after authenticating
# the session and asserting account membership; dashboard-api verifies the
# signature. It is a signing key: treat it like any other secret, never expose
# it to the browser (no NEXT_PUBLIC_ prefix), and rotate it on both sides
# together. Generate one with: openssl rand -base64 48
#
# Without it, /api/agentguard/ws-token answers 503 and the dashboard falls back
# to server-rendered data with no live updates.
AGENTGUARD_WS_TOKEN_SECRET=<a-long-random-string-shared-with-dashboard-api>

# KLIO ARTIFACTS — a SEPARATE, READ-ONLY credential.
#
# Artifacts are customer documents; the AGENTGUARD_S3_* pair above reads
# internal trace telemetry. Different bucket, different retention, very
# different blast radius — one credential for both would mean a leaked
# artifact key also reads every trace. The dashboard never writes an
# artifact, so this key needs GetObject on the artifact bucket and nothing
# else. Without these set, artifact downloads answer 503 instead of minting
# a URL that 403s on click.
KLIO_ARTIFACT_S3_ENDPOINT=<your-r2-endpoint>
KLIO_ARTIFACT_S3_REGION=auto
KLIO_ARTIFACT_S3_ACCESS_KEY_ID=<your-read-only-artifact-key>
KLIO_ARTIFACT_S3_SECRET_ACCESS_KEY=<your-read-only-artifact-secret>

# AUTH
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
